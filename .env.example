# --- Datenbank (Neon) -------------------------------------------------------
# Connection String aus dem Neon-Dashboard, "Pooled connection".
# Ohne diese Variable läuft die Seite mit der mitgelieferten Beispielkarte,
# das Backend kann dann aber nichts speichern.
DATABASE_URL="postgresql://user:passwort@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Backend-Login ----------------------------------------------------------
# Passwort für /admin. Mindestens 12 Zeichen.
ADMIN_PASSWORD="hier-ein-langes-passwort-eintragen"
# Zufälliger Schlüssel, mit dem das Login-Cookie signiert wird.
# Erzeugen mit:  openssl rand -base64 32
AUTH_SECRET="hier-ein-zufaelliges-secret-eintragen"

# --- Reservierungs-Mails ----------------------------------------------------
# Empfänger der Anfragen (mehrere durch Komma trennen).
RESERVATION_TO="info@laratatouille.es"

# Variante A: Resend (resend.com, kostenloser Tarif reicht).
# Die Absenderadresse muss dort als verifizierte Domain hinterlegt sein.
RESEND_API_KEY=""
RESERVATION_FROM="reservierung@laratatouille.es"

# Variante B: eigener Mailserver (SMTP). Wird genutzt, wenn kein RESEND_API_KEY
# gesetzt ist. Zugangsdaten des Postfachs beim Hoster.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Sonstiges --------------------------------------------------------------
# Öffentliche Adresse der Seite, für Sitemap, hreflang und Canonical-Tags.
NEXT_PUBLIC_SITE_URL="https://www.laratatouille.es"
